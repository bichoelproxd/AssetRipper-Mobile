<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
		<ApplicationId>com.assetripper.mobile</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
		<RootNamespace>AssetRipper.Mobile</RootNamespace>
		<AssemblyName>AssetRipper.GUI.Android</AssemblyName>
		<ImplicitUsings>disable</ImplicitUsings>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<!-- Universal APK: one package containing both 64-bit and 32-bit ARM. -->
		<RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
		<!-- NativeAOT / server GC are desktop-only choices. -->
		<IsAotCompatible>false</IsAotCompatible>
		<PublishAot>false</PublishAot>
		<ServerGarbageCollection>false</ServerGarbageCollection>
		<InvariantGlobalization>true</InvariantGlobalization>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<AndroidUseAapt2>true</AndroidUseAapt2>
		<EnableLLVM>false</EnableLLVM>
		<!-- The shared libraries lean on reflection-heavy decompiler code; keep trimming conservative. -->
		<PublishTrimmed>false</PublishTrimmed>
		<RunAOTCompilation>false</RunAOTCompilation>
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
		<OutputPath>..\0Bins\AssetRipper.GUI.Android\$(Configuration)\</OutputPath>
		<IntermediateOutputPath>..\0Bins\obj\AssetRipper.GUI.Android\$(Configuration)\</IntermediateOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\AssetRipper.GUI.Web\AssetRipper.GUI.Web.csproj" />
	</ItemGroup>

	<!--
		Microsoft does not publish an ASP.NET Core runtime pack for Android (NETSDK1082).
		The ASP.NET Core assemblies are plain managed code, so we download the linux-x64 pack
		(only for its portable .dll files) and bundle them inside the APK ourselves.
	-->
	<PropertyGroup>
		<DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
		<AspNetPackVersion>$(BundledNETCoreAppPackageVersion)</AspNetPackVersion>
		<AspNetPackDir>$(NuGetPackageRoot)microsoft.aspnetcore.app.runtime.linux-x64/$(AspNetPackVersion)/runtimes/linux-x64/lib/net10.0/</AspNetPackDir>
	</PropertyGroup>

	<ItemGroup>
		<PackageDownload Include="Microsoft.AspNetCore.App.Runtime.linux-x64" Version="[$(AspNetPackVersion)]" />
	</ItemGroup>

	<ItemGroup Condition="Exists('$(AspNetPackDir)')">
		<AspNetAssembly Include="$(AspNetPackDir)*.dll" />
		<Reference Include="@(AspNetAssembly)" Private="true" />
	</ItemGroup>

</Project>
